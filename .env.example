# Clave del proveedor LLM (solo backend). Nunca se commitea.
ANTHROPIC_API_KEY=
# Modelo (opcional)
LLM_MODEL=claude-opus-5-5
# Límites de costo (opcionales)
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
LLM_TIMEOUT_MS=90000
# Clave de acceso al link público (opcional; si se define, el chat la pide)
ACCESS_KEY=
PORT=3000
# Fecha de ejecución para vigencias (opcional, YYYY-MM-DD; por defecto hoy)
FECHA_EJECUCION=
